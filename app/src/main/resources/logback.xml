<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Capture exact startup time with file-safe characters -->
    <timestamp key="byCurrentStartup" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <!-- Console Logging Configuration -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %highlight(%-5level) %cyan(%logger{20}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Single Continuous File Logging Configuration -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <!-- Kept as a single file name so all sessions log into the same file -->
        <file>logs/bot.log</file>
        
        <append>true</append> 

        <encoder>
            <!-- Added %n%n at the beginning of the header to create two blank lines before the text -->
            <!-- Fixed the typo: changed /n to %n for proper system line breaks -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
            <header>%n%n============ BOT STARTUP: ${byCurrentStartup} ============%n</header>
        </encoder>
    </appender>

    <!-- Quiet down noisy libraries -->
    <logger name="net.dv8tion.jda" level="WARN"/>
    <logger name="com.sedmelluq.discord.lavaplayer" level="WARN"/>

    <!-- Root Logging Rule -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
